MYSQL_ROOT_PASSWORD=generate-with-start-script
APP_KEY=generate-with-start-script
MAPA_ADAPTER_TOKEN=generate-with-start-script
# Obtain the UUID for the ASR company after MAPA onboarding.
MAPA_COMPANY_UUID=
# Mobile routes remain disabled until the additive migration and user bindings are ready.
MAPA_MOBILE_ENABLED=false
# Explicit native platform administrator UUIDs; never infer this from a mobile request.
MAPA_MOBILE_SUPERADMIN_UUIDS=

# Voice pilot: real intake remains off until provider and human fallback acceptance.
MAPA_VOICE_ENABLED=false
MAPA_VOICE_DEMO_ENABLED=false
MAPA_VOICE_LIVE_ENABLED=false
MAPA_VOICE_BRIDGE_SECRET=
MAPA_EXOTEL_ACCOUNT_SID=
# Optional structured extraction; no model or key is preselected.
OPENAI_API_KEY=
MAPA_VOICE_EXTRACTION_MODEL=
# Bridge configuration; configure securely on the server, never in browser config.
MAPA_VOICE_STREAM_USER=
MAPA_VOICE_STREAM_PASSWORD=
SARVAM_API_KEY=
MAPA_VOICE_PUBLIC_WSS=
MAPA_VOICE_HUMAN_FALLBACK_CONFIGURED=false
MAPA_VOICE_DEFAULT_LANGUAGE=en

