# Live telephone intake stays disabled until commissioning is complete.
MAPA_VOICE_LIVE_ENABLED=false
MAPA_VOICE_HUMAN_FALLBACK_CONFIGURED=false
MAPA_VOICE_PUBLIC_WSS=
EXOTEL_ACCOUNT_SID=
STREAM_USER=mapa-stream
STREAM_PASSWORD=
SARVAM_API_KEY=

# Must equal the native API MAPA_VOICE_BRIDGE_SECRET. Separate from MAPA app
# passwords, Android sessions, provider keys, and the stream Basic password.
MAPA_VOICE_BRIDGE_SECRET=
MAPA_API_ORIGIN=http://application:8000
MAPA_ALLOW_INTERNAL_HTTP=true

HOST=127.0.0.1
PORT=8789
QUEUE_DB=./data/voice-journal.sqlite
MAX_CALLS=10
MAX_CALL_SECONDS=600
MAPA_VOICE_DEFAULT_LANGUAGE=en
