# Private systemd environment. No shell expansions. chmod 600.
RESTIC_REPOSITORY=s3:https://YOUR-ENDPOINT/YOUR-PRIVATE-BUCKET/mapa
RESTIC_PASSWORD_FILE=/opt/mapa-staging/release/private/restic-password
MAPA_RELEASE_DIRECTORY=/opt/mapa-staging/release
MAPA_EXPECTED_MYSQL_VOLUME=mapa-final-20261004t003110z-mysql
MAPA_EXPECTED_UPLOADS_VOLUME=mapa-final-20261004t003110z-uploads
# Provide the credentials required by your chosen storage provider only here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
