# Copy privately to private/api.env and retain existing encryption key.
APP_KEY=REQUIRED_EXISTING_APPLICATION_ENCRYPTION_KEY
MAPA_COMPANY_UUID=REQUIRED_EXISTING_COMPANY_UUID
MAPA_MOBILE_ENABLED=true
MAPA_MOBILE_SUPERADMIN_UUIDS=REQUIRED_EXISTING_EXPLICIT_ALLOWLIST
MAPA_MOBILE_ENROLLMENT_ENABLED=true
MAPA_MOBILE_COMPLETION_EVIDENCE_ENABLED=true
MAPA_VOICE_ENABLED=true
MAPA_VOICE_MANUAL_ENABLED=true
MAPA_GEOCODING_ENABLED=true
# Enable each only after additive migrations and the acceptance checklist.
MAPA_HOSPITAL_HANDOVER_ENABLED=false
MAPA_CALLER_TRACKING_ENABLED=false
MAPA_DEVICE_INGEST_ENABLED=false
MAPA_WHATSAPP_ENABLED=false
MAPA_MOBILE_PUSH_ENABLED=false
# Populate provider configuration privately after account setup.
MAPA_FCM_PROJECT_ID=
MAPA_FCM_CREDENTIALS_FILE=
MAPA_WHATSAPP_PHONE_ID=
MAPA_WHATSAPP_TOKEN=
MAPA_WHATSAPP_API_VERSION=
MAPA_WHATSAPP_TEMPLATE=
MAPA_WHATSAPP_LANGUAGE=en
